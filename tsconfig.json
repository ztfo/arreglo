{
    "compilerOptions": {
        "target": "es6",
        "module": "commonjs",
        "lib": ["es6", "dom"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "dist",
        "rootDir": "src",
        "typeRoots": [
            "./node_modules/@types",
            "./node_modules/@figma"
        ],
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "allowJs": true
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts",
        "src/**/*.tsx",
        "src/**/*.css"
    ],
    "exclude": ["node_modules"]
}